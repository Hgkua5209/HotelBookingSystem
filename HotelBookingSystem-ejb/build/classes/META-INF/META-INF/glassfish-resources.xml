<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE resources PUBLIC "-//GlassFish.org//DTD GlassFish Application Server 3.1 Resource Definitions//dtd" "http://glassfish.org/dtds/glassfish-resources_1_5.dtd">
<resources>
    <jdbc-connection-pool datasource-classname="com.mysql.cj.jdbc.MysqlDataSource" name="mysql_hotel_booking_pool" res-type="javax.sql.DataSource">
        <property name="User" value="root"/>
        <property name="Password" value=""/>
        <property name="URL" value="jdbc:mysql://localhost:3306/hotel_booking_db?useSSL=false&amp;allowPublicKeyRetrieval=true"/>
    </jdbc-connection-pool>
    <jdbc-resource enabled="true" jndi-name="jdbc/hotel_booking_pool" pool-name="mysql_hotel_booking_pool"/>
    <jdbc-resource enabled="true" jndi-name="java:module/roomdata" object-type="user" pool-name="mysql_hotel_booking_pool"/>
</resources>
